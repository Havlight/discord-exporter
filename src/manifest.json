{
  "manifest_version": 3,
  "name": "Discord Channel Exporter",
  "version": "0.1.2",
  "description": "匯出目前 Discord 頻道在指定時間範圍內的對話紀錄（HTML / JSON / TXT / CSV）。",
  "browser_specific_settings": {
    "gecko": {
      "id": "discord-channel-exporter@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "匯出 Discord 對話",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["lib/snowflake.js", "lib/formatters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "activeTab", "downloads"],
  "host_permissions": ["https://discord.com/*"]
}
